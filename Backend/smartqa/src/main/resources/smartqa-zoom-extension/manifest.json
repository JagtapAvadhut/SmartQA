{
  "manifest_version": 3,
  "name": "SmartQA Page Zoom",
  "version": "1.0.0",
  "description": "Sets Chromium page zoom for SmartQA headed browser execution",
  "permissions": ["tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
