# Copy to Backend/smartqa/.env (gitignored). Loaded automatically at startup.
# NEVER commit real keys.

# Database (defaults match local PostgreSQL)
# SMARTQA_DB_URL=r2dbc:postgresql://localhost:5432/smartqa
# SMARTQA_DB_JDBC_URL=jdbc:postgresql://localhost:5432/smartqa
# SMARTQA_DB_USERNAME=postgres
# SMARTQA_DB_PASSWORD=postgres

SMARTQA_AI_PROVIDER=gemini
SMARTQA_AI_PRIMARY_PROVIDER=gemini
SMARTQA_AI_FALLBACK_PROVIDER=ollama

GEMINI_MODEL=gemini-flash-latest
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Preferred: one ordered unique pool (comma-separated)
GEMINI_API_KEYS=

# Optional legacy extras (merged into the same pool, duplicates dropped):
# GEMINI_API_KEY=
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:3b

# RAG embeddings (not a chat model). Default Ollama nomic-embed-text.
# SMARTQA_RAG_EMBEDDING_PROVIDER=ollama
# SMARTQA_RAG_EMBEDDING_PROVIDER=gemini
